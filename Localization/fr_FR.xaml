    <sys:String x:Key="MTDA_MenuSetGenres">Définir les genres</sys:String>
    <sys:String x:Key="MTDA_MenuSetFeatures">Définir les fonctionnalités</sys:String>
    <sys:String x:Key="MTDA_MenuSetCompanies">Définir les entreprises</sys:String>
    <sys:String x:Key="MTDA_MenuSetAgeRegion">Définir l&apos;âge et la région</sys:String>
