    <sys:String x:Key="MTDA_AboutTitle">O Metadata AI</sys:String>
    <sys:String x:Key="MTDA_AboutDescription">Metadata AI pomaga porządkować i wzbogacać biblioteki Playnite przy użyciu spójnych wielojęzycznych metadanych oraz konfigurowalnych źródeł multimediów.</sys:String>
