    <sys:String x:Key="MTDA_ApplyProvider">Zastosuj dostawce</sys:String>
    <sys:String x:Key="MTDA_KeyHelpPage">Strona klucza/pomocy: </sys:String>
    <sys:String x:Key="MTDA_OpenProviderPage">Otworz strone dostawcy</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTitle">Użycie i limity</sys:String>
    <sys:String x:Key="MTDA_RefreshProviderUsage">Odśwież użycie</sys:String>
    <sys:String x:Key="MTDA_OpenProviderUsage">Otwórz stronę użycia</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageProbeHelp">Metadata AI aktualizuje te wartości z normalnych odpowiedzi dostawcy. OpenRouter jest sprawdzany bezpośrednio; dla OpenAI, Claude, Groq, Cerebras lub własnego endpointu odświeżenie wysyła jedno minimalne żądanie. Są to ostatnie znane wartości i mogą zależeć od modelu.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRefreshing">Odświeżanie...</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageAvailable">Bieżące limity dostawcy zostały zaktualizowane.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUnknown">Nie otrzymano jeszcze informacji o użyciu.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUnavailable">Dostawca nie zwrócił informacji o użyciu ani limitach.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageDashboardOnly">Ten dostawca nie udostępnia wtyczce przenośnej wartości pozostałego limitu. Otwórz stronę użycia, aby sprawdzić limity konta.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageLocal">Dostawca lokalny: brak zewnętrznego limitu API. Dostępność zależy od komputera i lokalnego serwera.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRequests">Żądania</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTokens">Tokeny</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageInputTokens">Tokeny wejściowe</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageOutputTokens">Tokeny wyjściowe</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageCredits">Środki</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageDaily">Użyto dzisiaj: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageMonthly">Użyto w tym miesiącu: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageReset">reset: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRetryAfter">Ponów po: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUpdated">Ostatnia aktualizacja: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageNoHeaders">Ostatnia odpowiedź dostawcy nie zawierała limitów liczbowych.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageOpenRouterFreeNote">OpenRouter rozpoznaje ten klucz jako bezpłatny, ale nie podaje dokładnej liczby bezpłatnych żądań pozostałych na dziś.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTimedOut">Zapytanie o użycie nie zakończyło się w ciągu 90 sekund.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageApiKeyRequired">Najpierw wprowadź klucz API dostawcy.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRefreshFailed">Nie udało się pobrać informacji o użyciu (HTTP {0}).</sys:String>
    <sys:String x:Key="MTDA_Endpoint">Endpoint</sys:String>
    <sys:String x:Key="MTDA_RestoreEndpoint">Przywróć endpoint</sys:String>
    <sys:String x:Key="MTDA_ApiKey">Klucz API</sys:String>
    <sys:String x:Key="MTDA_ApiKeyHelp">Wklej tutaj tylko wtedy, gdy dostawca tego wymaga. Dla lokalnych LM Studio i Ollama zwykle zostawia sie to pole puste. Nie wklejaj tutaj klucza ChatGPT: to musi byc klucz API wybranego dostawcy.</sys:String>
    <sys:String x:Key="MTDA_Model">Model</sys:String>
    <sys:String x:Key="MTDA_TestProvider">Testuj dostawce</sys:String>
    <sys:String x:Key="MTDA_UseLmStudioFree">Uzyj LM Studio za darmo</sys:String>
    <sys:String x:Key="MTDA_UseOllamaFree">Uzyj Ollama za darmo</sys:String>
    <sys:String x:Key="MTDA_FreeLocalFallback">Darmowy lokalny fallback</sys:String>
    <sys:String x:Key="MTDA_LocalFallbackCheckbox">Jesli dostawca w chmurze zawiedzie przez limit, kwote lub obciazenie, sproboj dostawcow lokalnych</sys:String>
    <sys:String x:Key="MTDA_LocalFallbackHelp">Aby to dzialalo, LM Studio musi miec wlaczony lokalny serwer albo Ollama musi dzialac z pobranym modelem. Klucz API dla lokalnych dostawcow zostaje pusty.</sys:String>
    <sys:String x:Key="MTDA_OutputLanguage">Jezyk wyjsciowy</sys:String>
    <sys:String x:Key="MTDA_Tone">Ton</sys:String>
    <sys:String x:Key="MTDA_Length">Dlugosc</sys:String>
    <sys:String x:Key="MTDA_LengthHelp">Dlugosc globalna podpowiada tez, ile elementow zwracac na listach. Dla tekstow dlugosc wedlug tokenu pozwala dopracowac kazdy blok: dla streszczenia Krotka=1 akapit, Srednia=2, Dluga=3 i Ekstra dluga=4-5.</sys:String>
    <sys:String x:Key="MTDA_LengthPerToken">Dlugosc wedlug tokenu</sys:String>
    <sys:String x:Key="MTDA_CurrentMetadata">Obecne metadane</sys:String>
    <sys:String x:Key="MTDA_CurrentMetadataHelp">Uzyj jako kontekstu pozwala AI uwzglednic obecne dane bez koniecznosci ich kopiowania. Normalizacja probuje poprawic i ujednolicic obecne metadane. Ignoruj nie wysyla tych danych do AI.</sys:String>
    <sys:String x:Key="MTDA_OfficialStoreContext">Używaj oficjalnych źródeł jako kontekstu AI</sys:String>
    <sys:String x:Key="MTDA_OfficialStoreContextHelp">Po włączeniu Metadata AI próbuje odczytać oficjalne źródło, takie jak Steam, Xbox Store, PlayStation Store lub Epic Store, przed wywołaniem AI. AI używa tych informacji jako kontekstu faktograficznego, a następnie tłumaczy lub normalizuje je zgodnie z szablonem.</sys:String>
    <sys:String x:Key="MTDA_StrictCompanyAgeRegion">Nie wymyslaj firm, klasyfikacji wiekowej ani regionu bez rozsadnej pewnosci</sys:String>
    <sys:String x:Key="MTDA_ExtraInstructions">Dodatkowe instrukcje</sys:String>
    <sys:String x:Key="MTDA_ExtraInstructionsHelp">Uzyj tego do dodatkowych regul redakcyjnych: tonu, slow do unikania, oczekiwanej struktury, preferowanych nazw albo kryteriow wiarygodnosci danych.</sys:String>
    <sys:String x:Key="MTDA_New">Nowy</sys:String>
    <sys:String x:Key="MTDA_Delete">Usun</sys:String>
    <sys:String x:Key="MTDA_RestoreDefaults">Przywroc domyslne</sys:String>
    <sys:String x:Key="MTDA_TemplateProfiles">Zapisane szablony</sys:String>
    <sys:String x:Key="MTDA_TemplateContent">Zawartość szablonu</sys:String>
    <sys:String x:Key="MTDA_TemplateName">Nazwa szablonu</sys:String>
    <sys:String x:Key="MTDA_TemplateHtmlHelp">Mozesz uzywac HTML w szablonie. Playnite renderuje znaczniki takie jak &amp;lt;p&amp;gt;, &amp;lt;h3&amp;gt;, &amp;lt;ul&amp;gt;, &amp;lt;li&amp;gt; i &amp;lt;br/&amp;gt;, dzieki czemu opis nie jest zbity.</sys:String>
    <sys:String x:Key="MTDA_DescriptionTokensTitle">Tokeny dostepne w opisie</sys:String>
    <sys:String x:Key="MTDA_Token">Token</sys:String>
    <sys:String x:Key="MTDA_Reference">Odniesienie</sys:String>
    <sys:String x:Key="MTDA_ImageSources">Zrodla obrazow</sys:String>
    <sys:String x:Key="MTDA_SourceKeysAndTests">Klucze i testy zrodel</sys:String>
    <sys:String x:Key="MTDA_MaintenanceBackupTitle">Kopia i przywracanie</sys:String>
    <sys:String x:Key="MTDA_MaintenanceBackupHelp">Eksportuj lub importuj aktualne ustawienia Metadata AI, w tym dostawców, szablony, reguły pól, pamięć słownictwa i konfigurację źródeł mediów.</sys:String>
    <sys:String x:Key="MTDA_MaintenanceBackupPrivateHelp">Uwaga: klucze API i sekrety są szyfrowane dla bieżącego użytkownika Windows. Na innym koncie lub komputerze trzeba wprowadzić je ponownie.</sys:String>
    <sys:String x:Key="MTDA_ExportSettingsBackup">Eksportuj kopię ustawień</sys:String>
    <sys:String x:Key="MTDA_ImportSettingsBackup">Importuj kopię ustawień</sys:String>
    <sys:String x:Key="MTDA_BackupExported">Kopia ustawień wyeksportowana.</sys:String>
    <sys:String x:Key="MTDA_BackupImported">Kopia ustawień zaimportowana.</sys:String>
    <sys:String x:Key="MTDA_BackupSecretsUnavailable">Nie udało się przywrócić części danych API, ponieważ kopia była zaszyfrowana dla innego użytkownika lub komputera Windows. Wprowadź je ponownie.</sys:String>
    <sys:String x:Key="MTDA_BackupImportInvalid">Wybrany plik kopii jest nieprawidłowy.</sys:String>
    <sys:String x:Key="MTDA_BackupImportConfirm">Import tej kopii zastąpi bieżące ustawienia Metadata AI i natychmiast je zapisze. Kontynuować?</sys:String>
    <sys:String x:Key="MTDA_BackupExportFailed">Nie można wyeksportować kopii ustawień.</sys:String>
    <sys:String x:Key="MTDA_BackupImportFailed">Nie można zaimportować kopii ustawień.</sys:String>
    <sys:String x:Key="MTDA_OfficialSteam">Oficjalny Steam</sys:String>
    <sys:String x:Key="MTDA_OfficialSteamHelp">Nie wymaga klucza API. Uzywa publicznych zasobow Steam, gdy gre da sie powiazac z AppID.</sys:String>
    <sys:String x:Key="MTDA_TestOfficialSteam">Testuj oficjalny Steam</sys:String>
    <sys:String x:Key="MTDA_SteamGridDbHelp">Klucz znajdziesz w profilu SteamGridDB, w Preferences/API. Jest opcjonalny dla gier Steam, ale zalecany: dodaje spolecznosciowe okladki, tla/hero i ikony, gdy oficjalny Steam nie ma odpowiedniego obrazu.</sys:String>
    <sys:String x:Key="MTDA_OpenSteamGridDb">Otworz SteamGridDB</sys:String>
    <sys:String x:Key="MTDA_TestSteamGridDb">Testuj SteamGridDB</sys:String>
    <sys:String x:Key="MTDA_RawgHelp">RAWG wymaga klucza API dla kazdego zapytania. Dostarcza glownie obraz glowny i zrzuty ekranu do tel.</sys:String>
    <sys:String x:Key="MTDA_TestRawg">Testuj RAWG</sys:String>
    <sys:String x:Key="MTDA_MobyGamesHelp">MobyGames uzywa api_key i moze dostarczac okladki oraz zrzuty ekranu, szczegolnie przydatne dla klasycznych gier.</sys:String>
    <sys:String x:Key="MTDA_TestMobyGames">Testuj MobyGames</sys:String>
    <sys:String x:Key="MTDA_IgdbHelp">Plugin automatycznie generuje Access Token Twitch/IGDB z tych danych. Nie musisz recznie kopiowac tymczasowych tokenow. Dostarcza okladki, screenshots i artworks.</sys:String>
    <sys:String x:Key="MTDA_TestIgdb">Testuj IGDB</sys:String>
    <sys:String x:Key="MTDA_Media">Media</sys:String>
    <sys:String x:Key="MTDA_Field">Pole</sys:String>
    <sys:String x:Key="MTDA_Get">Pobierz</sys:String>
    <sys:String x:Key="MTDA_Generate">Generuj</sys:String>
    <sys:String x:Key="MTDA_Apply">Zastosuj</sys:String>
    <sys:String x:Key="MTDA_Format">Format i rozdzielczość wyjściowa</sys:String>
    <sys:String x:Key="MTDA_OutputFormatHelp">Wybrany format i rozdzielczość określają plik końcowy zapisywany przez Metadata AI. Kandydaci mogą mieć inne rozdzielczości źródłowe: obrazy są skalowane, a przy zmianie proporcji przycinane od środka.</sys:String>
    <sys:String x:Key="MTDA_Cover">Okladka</sys:String>
    <sys:String x:Key="MTDA_Icon">Ikona</sys:String>
    <sys:String x:Key="MTDA_Background">Tlo</sys:String>
    <sys:String x:Key="MTDA_ActiveSources">Aktywne zrodla</sys:String>
    <sys:String x:Key="MTDA_SourceSteamOfficial">Oficjalny Steam: okladki i hero biblioteki, gdy gre da sie powiazac ze Steam</sys:String>
    <sys:String x:Key="MTDA_SourceSteamScreenshots">Oficjalne zrzuty Steam jako alternatywne tla</sys:String>
    <sys:String x:Key="MTDA_SourceSteamGridDb">SteamGridDB: spolecznosciowe okladki, ikony i hero</sys:String>
    <sys:String x:Key="MTDA_SourceSteamGridDbBackgroundGrids">Uzywaj poziomych gridow SteamGridDB jako tla, jesli brakuje hero</sys:String>
    <sys:String x:Key="MTDA_SourceRawg">RAWG: obraz glowny i zrzuty ekranu</sys:String>
    <sys:String x:Key="MTDA_SourceMobyGames">MobyGames: historyczne okladki i zrzuty ekranu</sys:String>
    <sys:String x:Key="MTDA_SourceIgdb">IGDB: okladki, artworki i zrzuty ekranu</sys:String>
    <sys:String x:Key="MTDA_MissingApiKeyHelp">Jesli aktywne zrodlo nie ma skonfigurowanego klucza API, plugin automatycznie je pominie podczas pobierania danych.</sys:String>
    <sys:String x:Key="MTDA_BackgroundLogoPreference">Preferencja logo dla tla</sys:String>
    <sys:String x:Key="MTDA_BackgroundLogoPreferenceHelp">Nie wszystkie zrodla idealnie udostepniaja te informacje. Plugin traktuje to jako preferencje: jesli nie moze rozroznic, wybiera obraz najlepiej pasujacy do formatu.</sys:String>
    <sys:String x:Key="MTDA_SelectionCriteria">Kryteria wyboru</sys:String>
    <sys:String x:Key="MTDA_AvoidNsfw">Unikaj tresci NSFW, gdy zrodlo je oznaczy</sys:String>
    <sys:String x:Key="MTDA_AvoidBlurred">Unikaj rozmytych stylow w okladkach i tlach</sys:String>
    <sys:String x:Key="MTDA_PreferOfficial">Preferuj oficjalne zasoby, gdy zrodlo to wskazuje</sys:String>
    <sys:String x:Key="MTDA_AvoidConsoleCovers">Unikaj okladek z paskiem/logo konsoli, gdy to mozliwe</sys:String>
    <sys:String x:Key="MTDA_SquareIconPreferGrid">Dla kwadratowej ikony priorytetuj kwadratowy grid przed przezroczysta ikona</sys:String>
    <sys:String x:Key="MTDA_SquareIconPreferGridHelp">Ta opcja unika wielu okraglych ikon lub przezroczystych logo: priorytetuje kwadratowy obraz i konwertuje go do ikony 256x256.</sys:String>
    <sys:String x:Key="MTDA_MaxMediaResults">Maksymalna liczba wynikow na gre</sys:String>
    <sys:String x:Key="MTDA_MaxMediaResultsHelp">Ile kandydatow ze wszystkich zrodel jest ocenianych przed wyborem najblizszego presetowi. Wyższe wartosci moga poprawic wybor, ale trwaja nieco dluzej.</sys:String>
    <sys:String x:Key="MTDA_AutoImportNewGames">Importuj metadane z Metadata AI po wykryciu nowych gier</sys:String>
    <sys:String x:Key="MTDA_AutoImportNewGamesHelp">Plugin pamieta istniejace gry i po aktualizacji biblioteki przetwarza tylko nowe ID. Dziala po Playnite, wiec moze nadpisac lub uzupelnic dane pobrane przez Playnite zgodnie z trybami stosowania.</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMetadata">Generuj metadane tekstowe i listy z AI</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMetadataHelp">Uzywa ustawien z kart AI, Szablony, Pola i Reguly. Jesli AI nie jest skonfigurowane, ta czesc zostanie pominieta.</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMedia">Pobieraj media automatycznie</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMediaHelp">Uzywa ustawien karty Media. Dla gier Steam moze uzywac oficjalnego Steam bez klucza; SteamGridDB jest dodatkowym zrodlem, jesli skonfigurowano klucz API.</sys:String>
    <sys:String x:Key="MTDA_AutoImportPlayniteNote">Uwaga: Playnite nie oferuje niezawodnego sposobu, aby plugin globalnie wylaczyl pobieranie metadanych przy imporcie. Metadata AI stosuje sie potem i respektuje reguly nadpisywania, dodawania lub uzupelniania pustych pol.</sys:String>
    <sys:String x:Key="MTDA_GenerateAndApply">Generuj i zastosuj</sys:String>
    <sys:String x:Key="MTDA_ExistingOnly">Tylko istniejace</sys:String>
    <sys:String x:Key="MTDA_Description">Opis</sys:String>
    <sys:String x:Key="MTDA_Genres">Gatunki</sys:String>
    <sys:String x:Key="MTDA_Tags">Tagi</sys:String>
    <sys:String x:Key="MTDA_Features">Cechy</sys:String>
    <sys:String x:Key="MTDA_Developers">Tworcy</sys:String>
    <sys:String x:Key="MTDA_Publishers">Wydawcy</sys:String>
    <sys:String x:Key="MTDA_Age">Wiek</sys:String>
    <sys:String x:Key="MTDA_Region">Region</sys:String>
    <sys:String x:Key="MTDA_Categories">Kategorie</sys:String>
    <sys:String x:Key="MTDA_SpecialFields">Pola specjalne</sys:String>
    <sys:String x:Key="MTDA_SortingName">Nazwa sortowania</sys:String>
    <sys:String x:Key="MTDA_Links">Linki</sys:String>
    <sys:String x:Key="MTDA_CompaniesLimitHelp">Dla firm zalecana wartosc to 1: plugin probuje zapisac tylko glownego tworcy/wydawce i unikac studiow wsparcia, portow, multiplayera lub dystrybucji regionalnej.</sys:String>
    <sys:String x:Key="MTDA_SortingLinksHelp">Nazwa sortowania jest liczona lokalnie: wykrywa sequele z 2/3, II/III lub v2/v3 i generuje wartosci jak Nazwa bazowa 01, 02, 03. Linki probuja uzywac oficjalnych URL; jesli gra pochodzi ze Steam i ma AppId, URL sklepu jest dodawany pewnie.</sys:String>
    <sys:String x:Key="MTDA_TagPrefix">Prefiks tagow</sys:String>
    <sys:String x:Key="MTDA_TagPrefixHelp">Jesli wpiszesz prefiks, zostanie dodany przed kazdym nowym tagiem. Przyklad: AI: Otwarty swiat.</sys:String>
    <sys:String x:Key="MTDA_CategoryPrefix">Prefiks kategorii</sys:String>
    <sys:String x:Key="MTDA_CategoryPrefixHelp">Przydatne do grupowania kategorii tworzonych przez plugin. Przyklad: Meta: Akcja.</sys:String>
    <sys:String x:Key="MTDA_Blacklist">Czarna lista terminow</sys:String>
    <sys:String x:Key="MTDA_BlacklistHelp">Terminy oddzielone przecinkiem, srednikiem lub nowa linia. Jesli sugestia zawiera ktorys z nich, zostanie odrzucona przed zastosowaniem.</sys:String>
    <sys:String x:Key="MTDA_EnableTemplateRules">Wlacz automatyczne reguly szablonow</sys:String>
    <sys:String x:Key="MTDA_EnableTemplateRulesHelp">Jesli wylaczone, plugin zawsze uzywa wybranego szablonu z karty Szablony. Jesli wlaczone, reguly zrodla, platformy lub typu moga zastapic go automatycznie.</sys:String>
    <sys:String x:Key="MTDA_GenreTemplateRules">Reguly szablonow wedlug typu gry</sys:String>
    <sys:String x:Key="MTDA_GenreTemplateRulesHelp">Sluzy do automatycznego wyboru szablonu wedlug typu gry. Plugin szuka terminu w obecnych gatunkach, tagach i kategoriach. Format: termin=NazwaSzablonu. Jesli znajdzie dopasowanie, uzywa tego szablonu zamiast aktywnego. Przyklad: RPG=RPG.</sys:String>
    <sys:String x:Key="MTDA_PlatformRules">Reguly wedlug platformy</sys:String>
    <sys:String x:Key="MTDA_PlatformRulesHelp">Sluzy do wyboru szablonu wedlug platformy gry. Ma priorytet nad regulami typu gry. Format: Platforma=NazwaSzablonu. Przyklad: Nintendo Switch=Krotka. Przydatne dla krotszych opisow przenosnych, bardziej technicznych opisow PC lub specjalnych szablonow emulacji.</sys:String>
    <sys:String x:Key="MTDA_SourceRules">Reguly wedlug zrodla</sys:String>
    <sys:String x:Key="MTDA_SourceRulesHelp">Sluzy do wyboru szablonu wedlug zrodla lub biblioteki, z ktorej zaimportowano gre, np. Steam, GOG, Epic, Xbox, PlayStation albo zrodlo niestandardowe. Ma priorytet nad platforma i typem. Format: Zrodlo=NazwaSzablonu. Przyklad: Steam=Dluga.</sys:String>
