    <sys:String x:Key="MTDA_AboutSupportTitle">サポート</sys:String>
    <sys:String x:Key="MTDA_AboutSupportDescription">Metadata AI が役立った場合は、Ko-fi で継続的な開発を支援できます。</sys:String>
    <sys:String x:Key="MTDA_AboutKoFiButton">Ko-fi で支援</sys:String>
