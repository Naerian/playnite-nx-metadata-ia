    <sys:String x:Key="MTDA_RestoreTemplatesConfirm">すべてのテンプレートを既定値に戻しますか？カスタムテンプレートは削除されます。</sys:String>
    <sys:String x:Key="MTDA_TemplateCopySuffix">コピー</sys:String>
