<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="MTDA_PluginName">Metadata IA</sys:String>
    <sys:String x:Key="MTDA_TabAI">AI</sys:String>
    <sys:String x:Key="MTDA_TabTemplates">テンプレート</sys:String>
    <sys:String x:Key="MTDA_TabMedia">メディア</sys:String>
    <sys:String x:Key="MTDA_TabImport">輸入</sys:String>
    <sys:String x:Key="MTDA_TabFields">フィールド</sys:String>
    <sys:String x:Key="MTDA_TabRules">ルール</sys:String>
    <sys:String x:Key="MTDA_OpenAICompatibleProvider">OpenAI対応AIプロバイダー</sys:String>
    <sys:String x:Key="MTDA_Provider">プロバイダー</sys:String>
    <sys:String x:Key="MTDA_ApplyProvider">プロバイダーを適用する</sys:String>
    <sys:String x:Key="MTDA_KeyHelpPage">キー/ヘルプページ:</sys:String>
    <sys:String x:Key="MTDA_OpenProviderPage">プロバイダーのページを開く</sys:String>
    <sys:String x:Key="MTDA_Endpoint">Endpoint</sys:String>
    <sys:String x:Key="MTDA_ApiKey">APIキー</sys:String>
    <sys:String x:Key="MTDA_ApiKeyHelp">プロバイダーが必要とする場合にのみ、ここに貼り付けてください。ローカルの LM Studio と Ollama の場合、これは通常空です。 ChatGPT キーをここに貼り付けないでください。選択したプロバイダーからの API キーである必要があります。</sys:String>
    <sys:String x:Key="MTDA_Model">モデル</sys:String>
    <sys:String x:Key="MTDA_TestProvider">テストプロバイダー</sys:String>
    <sys:String x:Key="MTDA_UseLmStudioFree">LM Studioを無料で使用する</sys:String>
    <sys:String x:Key="MTDA_UseOllamaFree">Ollamaを無料で使用する</sys:String>
    <sys:String x:Key="MTDA_FreeLocalFallback">無料のローカルフォールバック</sys:String>
    <sys:String x:Key="MTDA_LocalFallbackCheckbox">クォータ、制限、または需要が高いためにクラウド プロバイダーが失敗した場合は、ローカル プロバイダーを試してください</sys:String>
    <sys:String x:Key="MTDA_LocalFallbackHelp">これを機能させるには、LM Studio のローカル サーバーが有効になっているか、ダウンロードされたモデルで Ollama が実行されている必要があります。ローカルプロバイダーの場合、API キーは空です。</sys:String>
    <sys:String x:Key="MTDA_OutputLanguage">出力言語</sys:String>
    <sys:String x:Key="MTDA_Tone">トーン</sys:String>
    <sys:String x:Key="MTDA_Length">長さ</sys:String>
    <sys:String x:Key="MTDA_LengthHelp">グローバル長は、リストで返される項目の数にも影響します。テキストの場合、トークンごとの長さによって各ブロックを調整できます。概要の場合、短い = 1 段落、中 = 2、長い = 3、および超長い = 4 ～ 5。</sys:String>
    <sys:String x:Key="MTDA_LengthPerToken">トークンごとの長さ</sys:String>
    <sys:String x:Key="MTDA_CurrentMetadata">現在のメタデータ</sys:String>
    <sys:String x:Key="MTDA_CurrentMetadataHelp">コンテキストとして使用すると、AI は既存のデータを必ずしもコピーすることなく考慮できます。 Normalize は、現在のメタデータを修正して統合しようとします。無視すると、これらの詳細は AI に送信されません。</sys:String>
    <sys:String x:Key="MTDA_StrictCompanyAgeRegion">合理的に確信がない限り、会社、年齢評価、または地域を発明しないでください。</sys:String>
    <sys:String x:Key="MTDA_ExtraInstructions">追加のカスタム指示</sys:String>
    <sys:String x:Key="MTDA_ExtraInstructionsHelp">これを追加の編集ルールとして使用します。ブランド トーン、避けるべき言葉、望ましい構造、推奨される名前、詳細が信頼できるかどうかを判断する基準などです。</sys:String>
    <sys:String x:Key="MTDA_New">新しい</sys:String>
    <sys:String x:Key="MTDA_Delete">消去</sys:String>
    <sys:String x:Key="MTDA_RestoreDefaults">デフォルトに戻す</sys:String>
    <sys:String x:Key="MTDA_TemplateName">テンプレート名</sys:String>
    <sys:String x:Key="MTDA_TemplateHtmlHelp">テンプレート内で HTML を使用できます。 Playnite は &lt;p&gt;、&lt;h3&gt;、&lt;ul&gt;、&lt;li&gt;、&lt;br/&gt; などのタグをレンダリングするため、説明が詰め込まれたように見えません。</sys:String>
    <sys:String x:Key="MTDA_DescriptionTokensTitle">説明に使用できるトークン</sys:String>
    <sys:String x:Key="MTDA_Token">Token</sys:String>
    <sys:String x:Key="MTDA_Reference">参照</sys:String>
    <sys:String x:Key="MTDA_ImageSources">画像ソース</sys:String>
    <sys:String x:Key="MTDA_SourceKeysAndTests">ソースキーとテスト</sys:String>
    <sys:String x:Key="MTDA_OfficialSteam">公式スチーム</sys:String>
    <sys:String x:Key="MTDA_OfficialSteamHelp">API キーは必要ありません。ゲームが AppID と一致する場合は、パブリック Steam アセットを使用します。</sys:String>
    <sys:String x:Key="MTDA_TestOfficialSteam">公式 Steam をテストする</sys:String>
    <sys:String x:Key="MTDA_SteamGridDbHelp">SteamGridDB プロファイルの [設定/API] から取得します。 Steam ゲームではオプションですが、推奨します。公式 Steam に適切な画像がない場合に、コミュニティ カバー、ヒーロー/背景、アイコンを追加します。</sys:String>
    <sys:String x:Key="MTDA_OpenSteamGridDb">SteamGridDBを開く</sys:String>
    <sys:String x:Key="MTDA_TestSteamGridDb">SteamGridDB をテストする</sys:String>
    <sys:String x:Key="MTDA_RawgHelp">RWG ではリクエストごとに API キーが必要です。主にメイン画像と背景用のスクリーンショットを提供します。</sys:String>
    <sys:String x:Key="MTDA_TestRawg">RAWG をテストする</sys:String>
    <sys:String x:Key="MTDA_MobyGamesHelp">MobyGames は api_key を使用し、特にクラシック ゲームに役立つカバーやスクリーンショットを提供できます。</sys:String>
    <sys:String x:Key="MTDA_TestMobyGames">MobyGames をテストする</sys:String>
    <sys:String x:Key="MTDA_IgdbHelp">プラグインは、これらの詳細を使用して Twitch/IGDB アクセス トークンを自動的に生成します。一時トークンを手動でコピーする必要はありません。カバー、スクリーンショット、アートワークを提供します。</sys:String>
    <sys:String x:Key="MTDA_TestIgdb">IGDB をテストする</sys:String>
    <sys:String x:Key="MTDA_Media">メディア</sys:String>
    <sys:String x:Key="MTDA_Field">分野</sys:String>
    <sys:String x:Key="MTDA_Get">得る</sys:String>
    <sys:String x:Key="MTDA_Generate">生成する</sys:String>
    <sys:String x:Key="MTDA_Apply">適用する</sys:String>
    <sys:String x:Key="MTDA_Format">形式</sys:String>
    <sys:String x:Key="MTDA_Cover">カバー</sys:String>
    <sys:String x:Key="MTDA_Icon">アイコン</sys:String>
    <sys:String x:Key="MTDA_Background">背景</sys:String>
    <sys:String x:Key="MTDA_ActiveSources">アクティブなソース</sys:String>
    <sys:String x:Key="MTDA_SourceSteamOfficial">公式 Steam: ゲームが Steam と一致する場合のカバー、ロゴ、ライブラリ ヒーロー</sys:String>
    <sys:String x:Key="MTDA_SourceSteamScreenshots">代替背景としての公式 Steam スクリーンショット</sys:String>
    <sys:String x:Key="MTDA_SourceSteamGridDb">SteamGridDB: コミュニティのカバー、アイコン、ヒーロー、ロゴ</sys:String>
    <sys:String x:Key="MTDA_SourceSteamGridDbBackgroundGrids">十分なヒーローがいない場合は、水平方向の SteamGridDB グリッドを背景として使用します</sys:String>
    <sys:String x:Key="MTDA_SourceRawg">RWG: メイン画像とスクリーンショット</sys:String>
    <sys:String x:Key="MTDA_SourceMobyGames">MobyGames: 歴代のカバーとスクリーンショット</sys:String>
    <sys:String x:Key="MTDA_SourceIgdb">IGDB: カバー、アートワーク、スクリーンショット</sys:String>
    <sys:String x:Key="MTDA_MissingApiKeyHelp">アクティブなソースに API キーが設定されていない場合、プラグインはデータをフェッチするときに API キーを自動的にスキップします。</sys:String>
    <sys:String x:Key="MTDA_BackgroundLogoPreference">背景のロゴの設定</sys:String>
    <sys:String x:Key="MTDA_BackgroundLogoPreferenceHelp">すべての情報源がこの情報を完全に公開しているわけではありません。プラグインはそれを好みとして使用します。判断できない場合は、フォーマットに最も適合する画像を選択します。</sys:String>
    <sys:String x:Key="MTDA_SelectionCriteria">選定基準</sys:String>
    <sys:String x:Key="MTDA_AvoidNsfw">ソースが NSFW コンテンツをマークしている場合は、NSFW コンテンツを避ける</sys:String>
    <sys:String x:Key="MTDA_AvoidBlurred">カバーや背景でぼやけたスタイルを避ける</sys:String>
    <sys:String x:Key="MTDA_PreferOfficial">情報源が示している場合は公式アセットを優先する</sys:String>
    <sys:String x:Key="MTDA_AvoidConsoleCovers">可能な限り、コンソールのストライプ/ロゴが入ったカバーは避けてください。</sys:String>
    <sys:String x:Key="MTDA_SquareIconPreferGrid">正方形のアイコンの場合は、透明なアイコンよりも正方形のグリッドを優先します。</sys:String>
    <sys:String x:Key="MTDA_SquareIconPreferGridHelp">この最後のオプションは、多くの丸いアイコンや透明なロゴを回避します。正方形の画像を優先し、それを 256x256 のアイコンに変換します。</sys:String>
    <sys:String x:Key="MTDA_MaxMediaResults">ゲームごとにレビューする最大結果</sys:String>
    <sys:String x:Key="MTDA_MaxMediaResultsHelp">プリセットに最も近い候補を選択する前に、すべてのソースからいくつの候補が評価されるか。値を高くすると選択範囲が改善されますが、時間がかかります。</sys:String>
    <sys:String x:Key="MTDA_AutoImportNewGames">新しいゲーム検出時に Metadata IA でメタデータをインポート</sys:String>
    <sys:String x:Key="MTDA_AutoImportNewGamesHelp">プラグインは既存のゲームを記憶しており、ライブラリの更新後は新しい ID のみを処理します。これは Playnite の後に実行されるため、設定された適用モードに従って Playnite がダウンロードしたものを上書きまたは完了できます。</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMetadata">AIでテキストメタデータとリストを生成</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMetadataHelp">[AI]、[テンプレート]、[フィールド]、および [ルール] タブの設定を使用します。 AI が設定されていない場合、この部分はスキップされます。</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMedia">メディアを自動的にダウンロードする</sys:String>
    <sys:String x:Key="MTDA_AutoImportGenerateMediaHelp">「メディア」タブの設定を使用します。 Steam ゲームの場合は、キーなしで公式 Steam を使用できます。 API キーが設定されている場合、SteamGridDB は追加のソースとして使用されます。</sys:String>
    <sys:String x:Key="MTDA_AutoImportPlayniteNote">注意: Playnite は、インポート時のメタデータ取得をプラグインが全体的に無効化する信頼できる方法を提供していません。Metadata IA はその後に実行され、上書き、追加、空欄のみ補完のルールに従います。</sys:String>
    <sys:String x:Key="MTDA_GenerateAndApply">生成して適用する</sys:String>
    <sys:String x:Key="MTDA_ExistingOnly">既存のみ</sys:String>
    <sys:String x:Key="MTDA_Description">説明</sys:String>
    <sys:String x:Key="MTDA_Genres">ジャンル</sys:String>
    <sys:String x:Key="MTDA_Tags">タグ</sys:String>
    <sys:String x:Key="MTDA_Features">特徴</sys:String>
    <sys:String x:Key="MTDA_Developers">開発者</sys:String>
    <sys:String x:Key="MTDA_Publishers">出版社</sys:String>
    <sys:String x:Key="MTDA_Age">年</sys:String>
    <sys:String x:Key="MTDA_Region">地域</sys:String>
    <sys:String x:Key="MTDA_Categories">カテゴリー</sys:String>
    <sys:String x:Key="MTDA_SpecialFields">特殊な分野</sys:String>
    <sys:String x:Key="MTDA_SortingName">ソート名</sys:String>
    <sys:String x:Key="MTDA_Links">リンク</sys:String>
    <sys:String x:Key="MTDA_CompaniesLimitHelp">企業の場合、推奨値は 1 です。プラグインは、メインの開発者/パブリッシャーのみを保存し、サポート、移植、マルチプレイヤー、または地域の配布スタジオを回避しようとします。</sys:String>
    <sys:String x:Key="MTDA_SortingLinksHelp">名前の並べ替えはローカルで計算されます。2/3、II/III、または v2/v3 の続編が検出され、ベース名 01、02、03 のような値が生成されます。リンクは公式 URL を使用するように努めます。ゲームが Steam から提供され、AppId がある場合、ストア URL が確実に追加されます。</sys:String>
    <sys:String x:Key="MTDA_TagPrefix">タグプレフィックス</sys:String>
    <sys:String x:Key="MTDA_TagPrefixHelp">プレフィックスを入力すると、新しいタグの前にプレフィックスが追加されます。例: AI: オープンワールド。</sys:String>
    <sys:String x:Key="MTDA_CategoryPrefix">カテゴリの接頭辞</sys:String>
    <sys:String x:Key="MTDA_CategoryPrefixHelp">プラグインによって作成されたカテゴリをグループ化するのに役立ちます。例: メタ: アクション。</sys:String>
    <sys:String x:Key="MTDA_Blacklist">用語ブラックリスト</sys:String>
    <sys:String x:Key="MTDA_BlacklistHelp">用語はカンマ、セミコロン、または改行で区切られます。提案に提案が含まれている場合、それは適用される前に破棄されます。</sys:String>
    <sys:String x:Key="MTDA_EnableTemplateRules">自動テンプレートルールを有効にする</sys:String>
    <sys:String x:Key="MTDA_EnableTemplateRulesHelp">無効にすると、プラグインは常に [テンプレート] タブで選択したテンプレートを使用します。有効にすると、ソース、プラットフォーム、またはタイプのルールによって自動的に置き換えられます。</sys:String>
    <sys:String x:Key="MTDA_GenreTemplateRules">ゲームタイプ別のテンプレートルール</sys:String>
    <sys:String x:Key="MTDA_GenreTemplateRulesHelp">ゲームの種類に基づいてテンプレートを自動的に選択するために使用されます。プラグインは、現在のジャンル、タグ、カテゴリで用語を検索します。形式: term=テンプレート名。一致するものが見つかった場合は、アクティブなテンプレートの代わりにそのテンプレートが使用されます。例: RPG=RPG。</sys:String>
    <sys:String x:Key="MTDA_PlatformRules">プラットフォームごとのルール</sys:String>
    <sys:String x:Key="MTDA_PlatformRulesHelp">ゲームのプラットフォームに基づいてテンプレートを選択するために使用されます。ゲームタイプのルールよりも優先されます。形式: プラットフォーム=テンプレート名。例: Nintendo Switch = 短い。短いハンドヘルドの説明、より技術的な PC テキスト、または特別なエミュレーション テンプレートに役立ちます。</sys:String>
    <sys:String x:Key="MTDA_SourceRules">ソースごとのルール</sys:String>
    <sys:String x:Key="MTDA_SourceRulesHelp">Steam、GOG、Epic、Xbox、PlayStation、カスタム ソースなど、ゲームのインポート元のソースまたはライブラリに基づいてテンプレートを選択するために使用されます。プラットフォームやタイプよりも優先されます。形式: ソース=テンプレート名。例: スチーム=長い。</sys:String>
    <sys:String x:Key="MTDA_MenuGenerateReview">AI メタデータの生成とレビュー</sys:String>
    <sys:String x:Key="MTDA_MenuGenerateApply">AIメタデータを生成して適用する</sys:String>
    <sys:String x:Key="MTDA_MenuApplyAllList">リスト内のすべてのゲームに適用します</sys:String>
    <sys:String x:Key="MTDA_MenuApplySelected">選択したゲームに適用する</sys:String>
    <sys:String x:Key="MTDA_MenuSetDescriptions">セットの説明</sys:String>
    <sys:String x:Key="MTDA_MenuSetTags">タグを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetCategories">カテゴリを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetGenres">ジャンルを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetFeatures">機能を設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetCompanies">集合会社</sys:String>
    <sys:String x:Key="MTDA_MenuSetAgeRegion">年齢と地域を設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetLinks">リンクを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetSortingName">ソート名を設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetCover">セットカバー</sys:String>
    <sys:String x:Key="MTDA_MenuSetIcon">アイコンを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetBackground">背景を設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetFullMedia">フルメディアを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetCovers">セットカバー</sys:String>
    <sys:String x:Key="MTDA_MenuSetIcons">アイコンを設定する</sys:String>
    <sys:String x:Key="MTDA_MenuSetBackgrounds">背景を設定する</sys:String>
</ResourceDictionary>
