    <sys:String x:Key="MTDA_AboutSupportTitle">Soporte</sys:String>
    <sys:String x:Key="MTDA_AboutSupportDescription">Si Metadata AI te resulta útil, puedes apoyar su desarrollo en Ko-fi.</sys:String>
