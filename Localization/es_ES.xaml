    <sys:String x:Key="MTDA_Provider">Proveedor</sys:String>
    <sys:String x:Key="MTDA_ApplyProvider">Aplicar proveedor</sys:String>
    <sys:String x:Key="MTDA_KeyHelpPage">Pagina de clave/ayuda: </sys:String>
    <sys:String x:Key="MTDA_OpenProviderPage">Abrir pagina del proveedor</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTitle">Uso y límites</sys:String>
    <sys:String x:Key="MTDA_RefreshProviderUsage">Actualizar uso</sys:String>
    <sys:String x:Key="MTDA_OpenProviderUsage">Abrir pagina de uso</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageProbeHelp">Metadata AI actualiza estos valores con las respuestas normales del proveedor. En OpenRouter consulta directamente el estado de la clave; en OpenAI, Claude, Groq, Cerebras o un endpoint personalizado, actualizar envia una peticion minima. Son los ultimos valores conocidos y pueden depender del modelo.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRefreshing">Actualizando...</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageAvailable">Se han actualizado los limites actuales del proveedor.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUnknown">Todavia no se ha recibido informacion de uso.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUnavailable">El proveedor no ha devuelto informacion de uso o limites.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageDashboardOnly">Este proveedor no expone al plugin un valor portable de cuota restante.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageLocal">Proveedor local: no existe una cuota de API externa. La disponibilidad depende de tu PC y del servidor local.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRequests">Peticiones</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTokens">Tokens</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageInputTokens">Tokens de entrada</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageOutputTokens">Tokens de salida</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageCredits">Creditos</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageDaily">Usado hoy: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageMonthly">Usado este mes: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageReset">reinicio: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageRetryAfter">Reintentar tras: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageUpdated">Ultima actualizacion: {0}</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageNoHeaders">La ultima respuesta del proveedor no incluia limites numericos.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageOpenRouterFreeNote">OpenRouter identifica esta clave como gratuita, pero su endpoint de clave no informa del numero exacto de peticiones gratuitas restantes de hoy.</sys:String>
    <sys:String x:Key="MTDA_ProviderUsageTimedOut">La consulta de uso no termino en 90 segundos.</sys:String>
