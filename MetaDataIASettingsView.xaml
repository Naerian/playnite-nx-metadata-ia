<UserControl x:Class="MetaDataIAPlugin.MetaDataIASettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>
        <Style x:Key="FirstSectionHeaderBorder" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ThemedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Style="{DynamicResource HighlightBorder}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MediaDottedSeparator" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="1,4"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CheckBox Content="{DynamicResource MTDA_AdvancedMode}"
                  IsChecked="{Binding Settings.ShowAdvancedOptions}"
                  HorizontalAlignment="Right"
                  Margin="0,0,0,8"/>
        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource MTDA_TabAI}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_OpenAICompatibleProvider}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <TextBlock Text="{DynamicResource MTDA_Provider}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <ComboBox ItemsSource="{Binding Settings.ProviderPresetOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.ProviderPreset}"
                                      MinWidth="260"
                                      Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource MTDA_ApplyProvider}" MinWidth="140" Click="ApplyProvider_OnClick"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10" Opacity="0.9">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.ProviderKeyHelp}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Settings.ProviderBillingHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource MTDA_KeyHelpPage}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Settings.ProviderKeyUrl}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="{DynamicResource MTDA_OpenProviderPage}" HorizontalAlignment="Left" MinWidth="170" Margin="0,8,0,0" Click="OpenProviderPage_OnClick"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource MTDA_Endpoint}"/>
                        <TextBox Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_ApiKey}"/>
                        <PasswordBox x:Name="ApiKeyBox"
                                     PasswordChanged="ApiKeyBox_OnPasswordChanged"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_ApiKeyHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_Model}"/>
                        <TextBox Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{DynamicResource MTDA_TestProvider}" MinWidth="130" Margin="0,0,8,0" Click="TestProvider_OnClick"/>
                            <Button Content="{DynamicResource MTDA_UseLmStudioFree}" MinWidth="150" Margin="0,0,8,0" Click="UseLmStudio_OnClick"/>
                            <Button Content="{DynamicResource MTDA_UseOllamaFree}" MinWidth="140" Click="UseOllama_OnClick"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12" Opacity="0.9"
                                Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Border Style="{StaticResource FirstSectionHeaderBorder}">
                                    <TextBlock Text="{DynamicResource MTDA_FreeLocalFallback}" Style="{StaticResource SectionHeaderText}"/>
                                </Border>
                                <CheckBox Content="{DynamicResource MTDA_LocalFallbackCheckbox}" IsChecked="{Binding Settings.EnableLocalFallback}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="LM Studio" IsChecked="{Binding Settings.TryLmStudioFallback}" Width="110"/>
                                    <TextBlock Text="{DynamicResource MTDA_Model}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding Settings.LmStudioFallbackModel, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="Ollama" IsChecked="{Binding Settings.TryOllamaFallback}" Width="110"/>
                                    <TextBlock Text="{DynamicResource MTDA_Model}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding Settings.OllamaFallbackModel, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource MTDA_LocalFallbackHelp}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource MTDA_OutputLanguage}"/>
                        <ComboBox ItemsSource="{Binding Settings.LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_Tone}"/>
                        <ComboBox ItemsSource="{Binding Settings.ToneOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.Tone}" Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_Length}"/>
                        <ComboBox ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.Length}" Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_LengthHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource SectionHeaderBorder}"
                                Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource MTDA_LengthPerToken}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{}{short}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ShortLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{}{synopsis}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SynopsisLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Text="{}{premise}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PremiseLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{}{gameplay}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.GameplayLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="{}{tone}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ToneLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{}{setting}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SettingLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Text="{}{perspective}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PerspectiveLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{}{playModes}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PlayModesLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="4" Text="{}{estimatedLength}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.EstimatedLengthLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{}{similarGames}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SimilarGamesLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="5" Text="{}{notes}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.NotesLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="{}{recommendedFor}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.RecommendedForLength}" Margin="0,0,0,4"/>
                        </Grid>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_CurrentMetadata}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <ComboBox ItemsSource="{Binding Settings.ExistingMetadataModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ExistingMetadataMode}" Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_CurrentMetadataHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox Content="{DynamicResource MTDA_StrictCompanyAgeRegion}" IsChecked="{Binding Settings.StrictCompanyAgeRegion}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_ExtraInstructions}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBox Text="{Binding Settings.ExtraInstructions, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="100"
                                 Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_ExtraInstructionsHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabTemplates}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Settings.Templates}"
                                  SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220"
                                  Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource MTDA_New}" MinWidth="80" Margin="0,0,8,0" Click="AddTemplate_OnClick"/>
                        <Button Content="{DynamicResource MTDA_Delete}" MinWidth="80" Margin="0,0,8,0" Click="DeleteTemplate_OnClick"/>
                        <Button Content="{DynamicResource MTDA_RestoreDefaults}" MinWidth="150" Click="RestoreTemplates_OnClick"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource MTDA_TemplateName}"/>
                            <TextBox x:Name="TemplateNameBox"
                                     Text="{Binding SelectedTemplateNameText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,10"/>
                        </StackPanel>

                        <TextBox x:Name="TemplateEditorBox"
                                 Grid.Row="1"
                                 Text="{Binding SelectedTemplateBodyText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource MTDA_TemplateHtmlHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_DescriptionTokensTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Opacity="0.9">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="190">
                        <Grid ShowGridLines="True" Margin="0">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="6,4,6,4"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource MTDA_Token}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource MTDA_Reference}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="{}{short}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource MTDA_TokenShortHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="{}{synopsis}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource MTDA_TokenSynopsisHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="{}{premise}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource MTDA_TokenPremiseHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Text="{}{gameplay}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource MTDA_TokenGameplayHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Text="{}{tone}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource MTDA_TokenToneHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="6" Text="{}{setting}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource MTDA_TokenSettingHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="7" Text="{}{perspective}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{DynamicResource MTDA_TokenPerspectiveHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="8" Text="{}{playModes}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{DynamicResource MTDA_TokenPlayModesHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="9" Text="{}{estimatedLength}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{DynamicResource MTDA_TokenEstimatedLengthHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="10" Text="{}{similarGames}"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{DynamicResource MTDA_TokenSimilarGamesHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="11" Text="{}{notes}"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="{DynamicResource MTDA_TokenNotesHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="12" Text="{}{features}"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{DynamicResource MTDA_TokenFeaturesHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="13" Text="{}{recommendedFor}"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="{DynamicResource MTDA_TokenRecommendedForHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="14" Text="{}{genres}"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{DynamicResource MTDA_TokenGenresHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="15" Text="{}{tags}"/>
                            <TextBlock Grid.Row="15" Grid.Column="1" Text="{DynamicResource MTDA_TokenTagsHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="16" Text="{}{developers}"/>
                            <TextBlock Grid.Row="16" Grid.Column="1" Text="{DynamicResource MTDA_TokenDevelopersHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="17" Text="{}{publishers}"/>
                            <TextBlock Grid.Row="17" Grid.Column="1" Text="{DynamicResource MTDA_TokenPublishersHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="18" Text="{}{ageRatings}"/>
                            <TextBlock Grid.Row="18" Grid.Column="1" Text="{DynamicResource MTDA_TokenAgeRatingsHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="19" Text="{}{regions}"/>
                            <TextBlock Grid.Row="19" Grid.Column="1" Text="{DynamicResource MTDA_TokenRegionsHelp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="20" Text="{}{categories}"/>
                            <TextBlock Grid.Row="20" Grid.Column="1" Text="{DynamicResource MTDA_TokenCategoriesHelp}" TextWrapping="Wrap"/>
                        </Grid>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabMedia}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_ImageSources}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{Binding Settings.SteamGridDbHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_SourceKeysAndTests}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_OfficialSteam}"/>
                        <TextBlock Text="{DynamicResource MTDA_OfficialSteamHelp}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <Button Content="{DynamicResource MTDA_TestOfficialSteam}" HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,12" Click="TestSteamMedia_OnClick"/>
                        <Line Style="{StaticResource MediaDottedSeparator}"/>

                        <TextBlock Text="SteamGridDB"/>
                        <PasswordBox x:Name="SteamGridDbApiKeyBox"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     PasswordChanged="SteamGridDbApiKeyBox_OnPasswordChanged"
                                     Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_SteamGridDbHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="{DynamicResource MTDA_OpenSteamGridDb}" MinWidth="140" Margin="0,0,8,0" Click="OpenSteamGridDbPage_OnClick"/>
                            <Button Content="{DynamicResource MTDA_TestSteamGridDb}" MinWidth="140" Click="TestSteamGridDbMedia_OnClick"/>
                        </StackPanel>
                        <Line Style="{StaticResource MediaDottedSeparator}"/>

                        <TextBlock Text="RAWG"/>
                        <PasswordBox x:Name="RawgApiKeyBox"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     PasswordChanged="RawgApiKeyBox_OnPasswordChanged"
                                     Margin="0,2,0,4"/>
                        <TextBlock Text="{DynamicResource MTDA_RawgHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource MTDA_TestRawg}" HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,12" Click="TestRawgMedia_OnClick"/>
                        <Line Style="{StaticResource MediaDottedSeparator}"/>

                        <TextBlock Text="MobyGames"/>
                        <PasswordBox x:Name="MobyGamesApiKeyBox"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     PasswordChanged="MobyGamesApiKeyBox_OnPasswordChanged"
                                     Margin="0,2,0,4"/>
                        <TextBlock Text="{DynamicResource MTDA_MobyGamesHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource MTDA_TestMobyGames}" HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,12" Click="TestMobyGamesMedia_OnClick"/>
                        <Line Style="{StaticResource MediaDottedSeparator}"/>

                        <TextBlock Text="IGDB Client ID"/>
                        <PasswordBox x:Name="IgdbClientIdBox"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     PasswordChanged="IgdbClientIdBox_OnPasswordChanged"
                                     Margin="0,2,0,4"/>
                        <TextBlock Text="IGDB Client Secret"/>
                        <PasswordBox x:Name="IgdbClientSecretBox"
                                     Style="{StaticResource ThemedPasswordBox}"
                                     PasswordChanged="IgdbClientSecretBox_OnPasswordChanged"
                                     Margin="0,2,0,4"/>
                        <TextBlock Text="{DynamicResource MTDA_IgdbHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource MTDA_TestIgdb}" HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,16" Click="TestIgdbMedia_OnClick"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_Media}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource MTDA_Field}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource MTDA_Get}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource MTDA_Apply}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource MTDA_Format}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="{DynamicResource MTDA_Cover}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.DownloadCoverImage}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.CoverImageApplyMode}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Settings.CoverImagePresetOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.CoverImagePreset}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource MTDA_Icon}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Settings.DownloadIcon}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.IconApplyMode}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding Settings.IconPresetOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.IconPreset}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="3" Text="{DynamicResource MTDA_Background}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Settings.DownloadBackgroundImage}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.BackgroundImageApplyMode}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding Settings.BackgroundImagePresetOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.BackgroundImagePreset}" Margin="0,4,0,0"/>
                        </Grid>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_ActiveSources}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_SourceSteamOfficial}"
                                  IsChecked="{Binding Settings.MediaUseSteamOfficial}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceSteamScreenshots}"
                                  IsChecked="{Binding Settings.MediaUseSteamScreenshots}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceSteamGridDb}"
                                  IsChecked="{Binding Settings.MediaUseSteamGridDb}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceSteamGridDbBackgroundGrids}"
                                  IsChecked="{Binding Settings.MediaUseSteamGridDbBackgroundGrids}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceRawg}"
                                  IsChecked="{Binding Settings.MediaUseRawg}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceMobyGames}"
                                  IsChecked="{Binding Settings.MediaUseMobyGames}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SourceIgdb}"
                                  IsChecked="{Binding Settings.MediaUseIgdb}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_MissingApiKeyHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_BackgroundLogoPreference}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <ComboBox ItemsSource="{Binding Settings.BackgroundLogoPreferenceOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.BackgroundLogoPreference}"
                                  HorizontalAlignment="Left"
                                  MinWidth="220"
                                  Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_BackgroundLogoPreferenceHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_SelectionCriteria}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_AvoidNsfw}"
                                  IsChecked="{Binding Settings.MediaAvoidNsfw}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_AvoidBlurred}"
                                  IsChecked="{Binding Settings.MediaAvoidBlurred}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_PreferOfficial}"
                                  IsChecked="{Binding Settings.MediaPreferOfficial}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_AvoidConsoleCovers}"
                                  IsChecked="{Binding Settings.MediaAvoidConsoleCovers}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="{DynamicResource MTDA_SquareIconPreferGrid}"
                                  IsChecked="{Binding Settings.IconSquarePreferGrid}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_SquareIconPreferGridHelp}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_MaxMediaResults}"/>
                        <TextBox Text="{Binding Settings.MediaSearchMaxResults}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_MaxMediaResultsHelp}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabImport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_TabImport}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_AutoImportNewGames}"
                                  IsChecked="{Binding Settings.AutoImportNewGames}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportNewGamesHelp}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox Content="{DynamicResource MTDA_AutoImportGenerateMetadata}"
                                  IsChecked="{Binding Settings.AutoImportGenerateMetadata}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMetadataHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <CheckBox Content="{DynamicResource MTDA_AutoImportGenerateMedia}"
                                  IsChecked="{Binding Settings.AutoImportGenerateMedia}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMediaHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Opacity="0.9">
                            <TextBlock Text="{DynamicResource MTDA_AutoImportPlayniteNote}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabFields}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_GenerateAndApply}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource MTDA_Field}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource MTDA_Generate}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource MTDA_Apply}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Max." FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource MTDA_ExistingOnly}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="{DynamicResource MTDA_Description}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.GenerateDescription}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.DescriptionApplyMode}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource MTDA_Genres}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Settings.GenerateGenres}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.GenresApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Settings.MaxGenres}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingGenres}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Text="{DynamicResource MTDA_Tags}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Settings.GenerateTags}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.TagsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Settings.MaxTags}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingTags}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource MTDA_Features}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.GenerateFeatures}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.FeaturesApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Settings.MaxFeatures}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="4" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingFeatures}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="5" Text="{DynamicResource MTDA_Developers}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Settings.GenerateDevelopers}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.DevelopersApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding Settings.MaxDevelopers}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource MTDA_Publishers}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.GeneratePublishers}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PublishersApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding Settings.MaxPublishers}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="7" Text="{DynamicResource MTDA_Age}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding Settings.GenerateAgeRatings}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.AgeRatingsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding Settings.MaxAgeRatings}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="8" Text="{DynamicResource MTDA_Region}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Settings.GenerateRegions}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="8" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.RegionsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding Settings.MaxRegions}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="9" Text="{DynamicResource MTDA_Categories}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Settings.GenerateCategories}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="9" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.CategoriesApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding Settings.MaxCategories}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="9" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingCategories}" Margin="0,8,0,0"/>

                        </Grid>
                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_SpecialFields}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource MTDA_SortingName}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.GenerateSortingName}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SortingNameApplyMode}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="1" Text="{DynamicResource MTDA_Links}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.GenerateLinks}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.LinksApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Settings.MaxLinks}" Margin="0,4,8,0"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource MTDA_CompaniesLimitHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{DynamicResource MTDA_SortingLinksHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{DynamicResource MTDA_TagPrefix}" Margin="0,16,0,0"/>
                        <TextBox Text="{Binding Settings.TagPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_TagPrefixHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_CategoryPrefix}"/>
                        <TextBox Text="{Binding Settings.CategoryPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_CategoryPrefixHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_Blacklist}"/>
                        <TextBox Text="{Binding Settings.Blacklist, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="90"
                                 Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_BlacklistHelp}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabRules}"
                     Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_TabRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_EnableTemplateRules}"
                                  IsChecked="{Binding Settings.EnableTemplateRules}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource MTDA_EnableTemplateRulesHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_GenreTemplateRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_GenreTemplateRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.GenreTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_PlatformRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_PlatformRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.PlatformTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_SourceRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_SourceRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.SourceTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,18,0,8">
                            <TextBlock Text="{DynamicResource MTDA_VocabularyMemory}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_VocabularyMemoryHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.VocabularyMemory, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
