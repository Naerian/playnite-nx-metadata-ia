<UserControl x:Class="MetaDataIAPlugin.MetaDataIASettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MetaDataIAPlugin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinWidth="980" MinHeight="640" d:DesignHeight="780" d:DesignWidth="1100"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             FontSize="14"
             TextElement.FontSize="14"
             TextElement.Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="PageHeader" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}"/>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SecurePasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourcePriorityClickOverlay" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TokenHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="TokenNameCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenReferenceCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MediaDottedSeparator" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="1,4"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,8,0,16"/>
        </Style>
        <Style x:Key="SettingsToggleTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="Margin" Value="0,8,0,16"/>
        </Style>
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16"/>
        </Style>
        <Style x:Key="IconSquareButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxWidth" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="AdvancedSettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}"/>
        <Style x:Key="PageIntroCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}"/>
        <Style x:Key="PageSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="FieldTableRow" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style x:Key="TokenHelpText" TargetType="TextBlock" BasedOn="{StaticResource TokenCellText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.78"/>
        </Style>
        <Style x:Key="TokenCopyCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="TokenCopyButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{DynamicResource MTDA_CopyToken}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopyBorder"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M8,8 L16,8 A2,2 0 0 1 18,10 L18,18 A2,2 0 0 1 16,20 L8,20 A2,2 0 0 1 6,18 L6,10 A2,2 0 0 1 8,8 Z M6,14 L4,14 A2,2 0 0 1 2,12 L2,4 A2,2 0 0 1 4,2 L12,2 A2,2 0 0 1 14,4 L14,6"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopyBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CopyBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TestOperationBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SummaryCardDetail" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="SummaryStatusRow" TargetType="DockPanel">
            <Setter Property="LastChildFill" Value="True"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="SourceStatusBadge" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SourceCapabilityBadge" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style x:Key="MediaSourceHeaderHint" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,24,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style x:Key="TabGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="52" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource ControlBackgroundBrush}"/>
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Margin="16,8,8,8" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  HorizontalAlignment="Stretch"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="ExpanderHint" Grid.Row="1"
                                                           Text="{DynamicResource MTDA_ExpandSectionHint}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,4,0,0"/>
                                            </Grid>
                                        </ToggleButton>
                                        <Button x:Name="ExpanderChevron" Grid.Column="1"
                                                Style="{StaticResource IconSquareButton}"
                                                VerticalAlignment="Center"
                                                Click="ExpanderChevronButton_OnClick">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox.RenderTransform>
                                                    <TranslateTransform X="-1" Y="1"/>
                                                </Viewbox.RenderTransform>
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="ExpanderArrow"
                                                          Data="M6,9 L12,15 L18,9"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,16,8,16"
                                    TextElement.Foreground="{DynamicResource TextBrush}"
                                    TextElement.FontSize="14">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource GlyphBrush}"/>
                                <Setter TargetName="ExpanderHint" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ExpanderArrow" Property="Data" Value="M6,15 L12,9 L18,15"/>
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False">
                            <Rectangle x:Name="NavigationFill" RadiusX="4" RadiusY="4" Fill="Transparent"/>
                            <Rectangle x:Name="NavigationAccent" Width="4" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4" Fill="Transparent"/>
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="16,8,16,8"
                                              TextElement.Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="NavigationAccent" Property="Fill" Value="{DynamicResource GlyphBrush}"/>
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="4"
                                    Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    ClipToBounds="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                               Margin="8,8,8,16" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True"/>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False">
                            <Rectangle x:Name="TabFill" RadiusX="4" RadiusY="4" Fill="Transparent"/>
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,8"
                                              TextElement.Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabs" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
