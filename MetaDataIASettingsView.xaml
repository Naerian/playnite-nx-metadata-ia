<UserControl x:Class="MetaDataIAPlugin.MetaDataIASettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>
        <Style x:Key="FirstSectionHeaderBorder" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecurePasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourcePriorityClickOverlay" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourceKeysTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="SelectedIndex" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1"
                                      Margin="0"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              ContentSource="SelectedContent"
                                              Margin="0,8,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TokenHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="TokenNameCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenReferenceCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MediaDottedSeparator" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="1,4"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TestOperationBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CheckBox Content="{DynamicResource MTDA_AdvancedMode}"
                  IsChecked="{Binding Settings.ShowAdvancedOptions}"
                  HorizontalAlignment="Right"
                  Margin="0,0,0,8"/>
        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource MTDA_TabAI}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AiSectionProvider}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <TextBlock Text="{DynamicResource MTDA_Provider}" Style="{StaticResource FieldLabelText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <ComboBox ItemsSource="{Binding Settings.ProviderPresetOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.ProviderPreset}"
                                      SelectionChanged="ProviderPreset_OnSelectionChanged"
                                      MinWidth="260"
                                      Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource MTDA_ApplyProvider}" MinWidth="140" Click="ApplyProvider_OnClick"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10" Opacity="0.9">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.ProviderKeyHelp, Mode=OneWay}" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Settings.ProviderBillingHelp, Mode=OneWay}" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource MTDA_KeyHelpPage}" FontWeight="SemiBold"/>
                                    <Hyperlink Click="OpenProviderPage_OnClick">
                                        <Run Text="{Binding Settings.ProviderKeyUrl, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                                <Button Content="{DynamicResource MTDA_OpenProviderPage}" HorizontalAlignment="Left" MinWidth="170" Margin="0,8,0,0" Click="OpenProviderPage_OnClick"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding Settings.ShowEndpointEditor, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource MTDA_Endpoint}" Style="{StaticResource FieldLabelText}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource MTDA_RestoreEndpoint}"
                                        IsEnabled="{Binding Settings.CanRestoreProviderEndpoint, Mode=OneWay}"
                                        MinWidth="150"
                                        Click="RestoreEndpoint_OnClick"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource MTDA_ApiKey}" Style="{StaticResource FieldLabelText}"/>
                        <PasswordBox x:Name="ApiKeyBox"
                                     PasswordChanged="ApiKeyBox_OnPasswordChanged"
                                     Style="{StaticResource SecurePasswordBox}"
                                     Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_ApiKeyHelp}" Style="{StaticResource HintText}"/>

                        <TextBlock Text="{DynamicResource MTDA_Model}" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{DynamicResource MTDA_TestProvider}" MinWidth="130" Click="TestProvider_OnClick"/>
                        </StackPanel>
                        <Border x:Name="ProviderTestStatusPanel" Style="{StaticResource TestOperationBorder}">
                            <StackPanel>
                                <ProgressBar x:Name="ProviderTestProgress" IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ProviderTestStatusText" TextWrapping="Wrap"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="ProviderTestElapsedText" VerticalAlignment="Center" Opacity="0.75"/>
                                    <Button x:Name="ProviderTestCancelButton"
                                            Content="{DynamicResource MTDA_CancelTest}"
                                            HorizontalAlignment="Right"
                                            MinWidth="110"
                                            DockPanel.Dock="Right"
                                            Click="CancelProviderTest_OnClick"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TestOperationBorder}" Visibility="Visible">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource MTDA_ProviderUsageTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="ProviderUsageProgress" IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock x:Name="ProviderUsageStatusText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ProviderUsageDetailsText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ProviderUsageUpdatedText" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RefreshProviderUsageButton"
                                            Content="{DynamicResource MTDA_RefreshProviderUsage}"
                                            MinWidth="150"
                                            Margin="0,0,8,0"
                                            Click="RefreshProviderUsage_OnClick"/>
                                    <Button x:Name="OpenProviderUsageButton"
                                            Content="{DynamicResource MTDA_OpenProviderUsage}"
                                            MinWidth="170"
                                            Click="OpenProviderUsage_OnClick"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource MTDA_ProviderUsageProbeHelp}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AiSectionOutput}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <TextBlock Text="{DynamicResource MTDA_OutputLanguage}" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox ItemsSource="{Binding Settings.LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_Tone}" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox ItemsSource="{Binding Settings.ToneOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.Tone}" Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource MTDA_Length}" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.Length}" Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_LengthHelp}" Style="{StaticResource HintText}"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AiSectionReliability}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_CurrentMetadata}" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox ItemsSource="{Binding Settings.ExistingMetadataModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ExistingMetadataMode}" Margin="0,2,0,10"/>
                        <TextBlock Text="{DynamicResource MTDA_CurrentMetadataHelp}" Style="{StaticResource HintText}"/>
                        <CheckBox Content="{DynamicResource MTDA_OfficialStoreContext}" 
                                  IsChecked="{Binding Settings.UseOfficialStoreContext}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_OfficialStoreContextHelp}"
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,8"/>
                        <CheckBox Content="{DynamicResource MTDA_StrictCompanyAgeRegion}" IsChecked="{Binding Settings.StrictCompanyAgeRegion}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}"
                                Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource MTDA_AiSectionAdvanced}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <StackPanel Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource FirstSectionHeaderBorder}">
                                <TextBlock Text="{DynamicResource MTDA_LengthPerToken}" Style="{StaticResource SectionHeaderText}"/>
                            </Border>
                            <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{}{short}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ShortLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{}{synopsis}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SynopsisLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Text="{}{premise}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PremiseLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{}{gameplay}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.GameplayLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="{}{tone}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ToneLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{}{setting}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SettingLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Text="{}{perspective}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PerspectiveLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{}{playModes}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PlayModesLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="4" Text="{}{estimatedLength}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.EstimatedLengthLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{}{similarGames}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SimilarGamesLength}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="5" Text="{}{notes}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.NotesLength}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="{}{recommendedFor}" Margin="0,4,8,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="4" ItemsSource="{Binding Settings.LengthOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.RecommendedForLength}" Margin="0,0,0,4"/>
                            </Grid>

                            <Border Style="{StaticResource SectionHeaderBorder}">
                                <TextBlock Text="{DynamicResource MTDA_FreeLocalFallback}" Style="{StaticResource SectionHeaderText}"/>
                            </Border>
                            <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12" Opacity="0.9">
                                <StackPanel>
                                    <CheckBox Content="{DynamicResource MTDA_LocalFallbackCheckbox}" IsChecked="{Binding Settings.EnableLocalFallback}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="LM Studio" IsChecked="{Binding Settings.TryLmStudioFallback}" Width="110"/>
                                        <TextBlock Text="{DynamicResource MTDA_Model}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding Settings.LmStudioFallbackModel, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="Ollama" IsChecked="{Binding Settings.TryOllamaFallback}" Width="110"/>
                                        <TextBlock Text="{DynamicResource MTDA_Model}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding Settings.OllamaFallbackModel, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource MTDA_LocalFallbackHelp}" Style="{StaticResource HintText}" Margin="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionHeaderBorder}">
                                <TextBlock Text="{DynamicResource MTDA_ExtraInstructions}" Style="{StaticResource SectionHeaderText}"/>
                            </Border>
                            <TextBox Text="{Binding Settings.ExtraInstructions, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="100"
                                     Margin="0,2,0,8"/>
                            <TextBlock Text="{DynamicResource MTDA_ExtraInstructionsHelp}" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabTemplates}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource FirstSectionHeaderBorder}">
                        <TextBlock Text="{DynamicResource MTDA_TemplateProfiles}" Style="{StaticResource SectionHeaderText}"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Settings.Templates}"
                                  SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220"
                                  Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource MTDA_New}" MinWidth="80" Margin="0,0,8,0" Click="AddTemplate_OnClick"/>
                        <Button Content="{DynamicResource MTDA_Delete}" MinWidth="80" Margin="0,0,8,0" Click="DeleteTemplate_OnClick"/>
                        <Button Content="{DynamicResource MTDA_RestoreDefaults}" MinWidth="150" Click="RestoreTemplates_OnClick"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,8,0,10">
                            <TextBlock Text="{DynamicResource MTDA_TemplateContent}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{DynamicResource MTDA_TemplateName}"/>
                            <TextBox x:Name="TemplateNameBox"
                                     Text="{Binding SelectedTemplateNameText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,10"/>
                        </StackPanel>

                        <TextBox x:Name="TemplateEditorBox"
                                 Grid.Row="2"
                                 Text="{Binding SelectedTemplateBodyText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3"
                                   Text="{DynamicResource MTDA_TemplateHtmlHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_DescriptionTokensTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Border BorderBrush="{DynamicResource GlyphBrush}"
                                Background="{DynamicResource ControlIdleBackgroundBrush}"
                                BorderThickness="1"
                                Opacity="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="420" MaxHeight="560">
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource TokenHeaderCell}">
                                        <TextBlock Text="TOKEN" FontWeight="SemiBold" Style="{StaticResource TokenCellText}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TokenHeaderCell}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="REFERENCIA" FontWeight="SemiBold" Style="{StaticResource TokenCellText}"/>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource TokenNameCell}"><TextBlock Text="{}{short}" Style="{StaticResource TokenCellText}"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TokenReferenceCell}"><TextBlock Text="{DynamicResource MTDA_TokenShortHelp}" Style="{StaticResource TokenCellText}"/></Border>
                                    <Border Grid.Row="2" Style="{StaticResource TokenNameCell}"><TextBlock Text="{}{synopsis}" Style="{StaticResource TokenCellText}"/></Border>
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TokenReferenceCell}"><TextBlock Text="{DynamicResource MTDA_TokenSynopsisHelp}" Style="{StaticResource TokenCellText}"/></Border>
                                    <Border Grid.Row="3" Style="{StaticResource TokenNameCell}"><TextBlock Text="{}{premise}" Style="{StaticResource TokenCellText}"/></Border>
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TokenReferenceCell}"><TextBlock Text="{DynamicResource MTDA_TokenPremiseHelp}" Style="{StaticResource TokenCellText}"/></Border>
