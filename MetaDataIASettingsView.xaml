                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource MTDA_CoverMinimumWidth}"/><TextBox Text="{Binding Settings.MediaMinimumCoverWidth}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource MTDA_IconMinimumWidth}"/><TextBox Text="{Binding Settings.MediaMinimumIconWidth}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource MTDA_BackgroundMinimumWidth}"/><TextBox Text="{Binding Settings.MediaMinimumBackgroundWidth}" Margin="0,3,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource MTDA_MediaQualityAndRepairHelp}" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_ExtraMetadataLogos}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_EnableExtraMetadataLogos}" IsChecked="{Binding Settings.EnableExtraMetadataLoaderLogos}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_ExtraMetadataLogosHelp}" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabImport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_TabImport}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_AutoImportNewGames}"
                                  IsChecked="{Binding Settings.AutoImportNewGames}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportNewGamesHelp}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox Content="{DynamicResource MTDA_AutoImportGenerateMetadata}"
                                  IsChecked="{Binding Settings.AutoImportGenerateMetadata}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMetadataHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <CheckBox Content="{DynamicResource MTDA_AutoImportGenerateMedia}"
                                  IsChecked="{Binding Settings.AutoImportGenerateMedia}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMediaHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" Padding="10" Opacity="0.9">
                            <TextBlock Text="{DynamicResource MTDA_AutoImportPlayniteNote}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabFields}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_FieldBehaviorTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_FieldBehaviorHelp}" Style="{StaticResource HintText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource MTDA_Field}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource MTDA_Generate}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource MTDA_Apply}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource MTDA_Maximum}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource MTDA_UseExistingPlayniteValues}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Text="{DynamicResource MTDA_Description}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.GenerateDescription}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.DescriptionApplyMode}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource MTDA_Genres}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Settings.GenerateGenres}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.GenresApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Settings.MaxGenres}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingGenres}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Text="{DynamicResource MTDA_Tags}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Settings.GenerateTags}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.TagsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Settings.MaxTags}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingTags}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource MTDA_Features}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.GenerateFeatures}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.FeaturesApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Settings.MaxFeatures}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="4" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingFeatures}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="5" Text="{DynamicResource MTDA_Developers}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Settings.GenerateDevelopers}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.DevelopersApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding Settings.MaxDevelopers}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource MTDA_Publishers}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.GeneratePublishers}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.PublishersApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding Settings.MaxPublishers}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="7" Text="{DynamicResource MTDA_Age}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding Settings.GenerateAgeRatings}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.AgeRatingsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding Settings.MaxAgeRatings}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="8" Text="{DynamicResource MTDA_Region}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Settings.GenerateRegions}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="8" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.RegionsApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding Settings.MaxRegions}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="9" Text="{DynamicResource MTDA_Categories}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Settings.GenerateCategories}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="9" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.CategoriesApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding Settings.MaxCategories}" Margin="0,4,8,0"/>
                            <CheckBox Grid.Row="9" Grid.Column="4" IsChecked="{Binding Settings.PreferExistingCategories}" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="10" Text="{DynamicResource MTDA_SortingName}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding Settings.GenerateSortingName}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="10" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SortingNameApplyMode}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="11" Text="{DynamicResource MTDA_Links}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding Settings.GenerateLinks}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="11" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.LinksApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="11" Grid.Column="3" Text="{Binding Settings.MaxLinks}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="12" Text="{DynamicResource MTDA_ReleaseDate}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding Settings.GenerateReleaseDate}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="12" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ReleaseDateApplyMode}" Margin="0,4,8,0"/>

                            <TextBlock Grid.Row="13" Text="{DynamicResource MTDA_Series}" Margin="0,8,0,0"/>
                            <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding Settings.GenerateSeries}" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="13" Grid.Column="2" ItemsSource="{Binding Settings.ApplyModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.SeriesApplyMode}" Margin="0,4,8,0"/>
                            <TextBox Grid.Row="13" Grid.Column="3" Text="{Binding Settings.MaxSeries}" Margin="0,4,8,0"/>

                        </Grid>
                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_FieldAccuracyNotesTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <Border BorderBrush="{DynamicResource GlyphBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderThickness="1"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource MTDA_DeveloperPublisherAccuracyNote}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource MTDA_SortingNameAccuracyNote}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource MTDA_UseExistingPlayniteValuesHelp}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_PrefixesTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_TagPrefix}"/>
                        <TextBox Text="{Binding Settings.TagPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_TagPrefixHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_CategoryPrefix}"/>
                        <TextBox Text="{Binding Settings.CategoryPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_CategoryPrefixHelp}" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_BlacklistTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_Blacklist}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Settings.Blacklist, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="90"
                                 Margin="0,2,0,8"/>
                        <TextBlock Text="{DynamicResource MTDA_BlacklistHelp}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabMaintenance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_MaintenanceSetupTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceSetupHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_OpenSetupWizard}"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                Click="OpenSetupWizard_OnClick"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_MaintenanceBackupTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceBackupHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceBackupPrivateHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Opacity="0.85"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource MTDA_ExportSettingsBackup}"
                                    MinWidth="180"
                                    Margin="0,0,8,0"
                                    Click="ExportSettingsBackup_OnClick"/>
                            <Button Content="{DynamicResource MTDA_ImportSettingsBackup}"
                                    MinWidth="180"
                                    Click="ImportSettingsBackup_OnClick"/>
                        </StackPanel>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_MaintenanceMediaCleanupTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceMediaCleanupHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_CleanupObsoleteMedia}"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                Click="CleanupObsoleteMedia_OnClick"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AuditTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_AuditMaintenanceHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_MenuAuditLibrary}" HorizontalAlignment="Left" MinWidth="220" Click="AuditLibrary_OnClick"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_MaintenanceDiagnosticsTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceDiagnosticsHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_ExportDiagnostics}"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                Click="ExportDiagnostics_OnClick"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_MaintenanceHistoryTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_MaintenanceHistoryHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_OpenHistory}"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                Click="OpenHistory_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabRules}"
                     Visibility="{Binding Settings.ShowAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_TabRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <CheckBox Content="{DynamicResource MTDA_EnableTemplateRules}"
                                  IsChecked="{Binding Settings.EnableTemplateRules}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource MTDA_EnableTemplateRulesHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_GenreTemplateRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_GenreTemplateRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.GenreTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_PlatformRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_PlatformRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.PlatformTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_SourceRules}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_SourceRulesHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.SourceTemplateRules, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,18,0,8">
                            <TextBlock Text="{DynamicResource MTDA_VocabularyMemory}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_VocabularyMemoryHelp}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding Settings.VocabularyMemory, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource MTDA_TabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AboutTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_AboutDescription}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Settings.AboutVersionAuthor, Mode=OneWay}"
                                   FontWeight="SemiBold"/>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AboutLinksTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="GitHub"
                                    MinWidth="130"
                                    Margin="0,0,8,0"
                                    Click="OpenRepository_OnClick"/>
                            <Button Content="{DynamicResource MTDA_AboutWikiButton}"
                                    MinWidth="150"
                                    Margin="0,0,8,0"
                                    Click="OpenWiki_OnClick"/>
                            <Button Content="{DynamicResource MTDA_AboutReportIssueButton}"
                                    MinWidth="170"
                                    Click="OpenReportIssue_OnClick"/>
                        </StackPanel>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource MTDA_AboutSupportTitle}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource MTDA_AboutSupportDescription}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource MTDA_AboutKoFiButton}"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                Padding="18,8"
                                Click="OpenKoFi_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
