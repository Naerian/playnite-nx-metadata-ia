<UserControl x:Class="MetaDataIAPlugin.MetaDataIASettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MetaDataIAPlugin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:SubtractValueConverter x:Key="MediaSourceHeaderWidthConverter"/>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecurePasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourcePriorityClickOverlay" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TokenHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="TokenNameCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenReferenceCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="TokenCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MediaDottedSeparator" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="1,4"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="AdvancedSettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
            <Setter Property="BorderThickness" Value="2,1,1,1"/>
        </Style>
        <Style x:Key="PageIntroCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="FieldTableRow" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style x:Key="TokenHelpText" TargetType="TextBlock" BasedOn="{StaticResource TokenCellText}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style x:Key="TestOperationBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SummaryCardDetail" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="SummaryStatusRow" TargetType="DockPanel">
            <Setter Property="LastChildFill" Value="True"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="SourceStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SourceCapabilityBadge" TargetType="Border" BasedOn="{StaticResource SourceStatusBadge}">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavigationItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                Padding="13,10">
                            <ContentPresenter x:Name="NavigationHeader"
                                              ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource GlyphBrush}"
                                    BorderThickness="1"
                                    Padding="8"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Column="2"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopSectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TopTabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="16,9,16,8">
                            <ContentPresenter x:Name="TopTabHeader"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopTabBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TopTabBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                <Setter TargetName="TopTabBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                                <Setter TargetName="TopTabHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TopTabBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                <Setter TargetName="TopTabBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopSectionTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TopSectionTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource GlyphBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Margin="0,10,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaSourceExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="MediaSourceHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="14,0,12,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainSettingsNavigation" Style="{StaticResource TopSectionTabControl}">
            <TabItem Header="{DynamicResource MTDA_TabOverview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource PageIntroCard}">
                            <TextBlock Text="{DynamicResource MTDA_ConfigurationSummaryHelp}"
                                       TextWrapping="Wrap"
                                       Opacity="0.9"
                                       Margin="0"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource SummaryCard}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="16,13">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="ConfigurationProviderStatusBadge" Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="12,0,0,0">
                                            <TextBlock x:Name="ConfigurationProviderStatusText"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource MTDA_Provider}" Style="{StaticResource SummaryCardTitle}"/>
                                    </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="ConfigurationProviderSummaryText" Style="{StaticResource SummaryCardValue}"/>
                                    <TextBlock x:Name="ConfigurationProviderEndpointText" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SummaryCard}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="14,12">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                    <DockPanel LastChildFill="True">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <TextBlock x:Name="ConfigurationFieldsSummaryText"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource MTDA_TabFields}" Style="{StaticResource SummaryCardTitle}"/>
                                    </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="ConfigurationFieldsDetailText" Style="{StaticResource SummaryCardDetail}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SummaryCard}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="14,12">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource MTDA_TabTemplates}" Style="{StaticResource SummaryCardTitle}"/>
                                    </Border>
                                    <TextBlock x:Name="ConfigurationTemplateSummaryText" Style="{StaticResource SummaryCardValue}"/>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <TextBlock x:Name="ConfigurationTemplateDetailText"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource MTDA_SummaryTemplateRules}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SummaryCard}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="14,12">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                    <DockPanel LastChildFill="True">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <TextBlock x:Name="ConfigurationMediaSummaryText"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource MTDA_TabMedia}" Style="{StaticResource SummaryCardTitle}"/>
                                    </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="ConfigurationMediaDetailText" Style="{StaticResource SummaryCardDetail}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SummaryCard}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="14,12">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource MTDA_SummaryAutomation}" Style="{StaticResource SummaryCardTitle}"/>
                                    </Border>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}" Margin="0">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationAutomationSummaryText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_AutoImportNewGames}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationAutomationAiStatusText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMetadata}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationAutomationMediaStatusText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_AutoImportGenerateMedia}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource SummaryCard}" Margin="0"
                                    BorderBrush="{DynamicResource PositiveRatingBrush}" BorderThickness="4,1,1,1">
                                <StackPanel Margin="16,13">
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource MTDA_AiSectionReliability}" Style="{StaticResource SummaryCardTitle}"/>
                                    </Border>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}" Margin="0">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationOfficialContextStatusText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_SummaryOfficialContext}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationStrictFactsStatusText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_SummaryStrictFacts}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SummaryStatusRow}">
                                        <Border Style="{StaticResource SummaryPill}" DockPanel.Dock="Right" Margin="10,0,0,0"><TextBlock x:Name="ConfigurationLocalFallbackStatusText"/></Border>
                                        <TextBlock Text="{DynamicResource MTDA_SummaryLocalFallback}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource MTDA_TabAI}">
                <Grid Margin="8">
                    <TabControl Style="{StaticResource SettingsNavigationTabControl}">
                        <TabItem Header="{DynamicResource MTDA_Provider}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8" HorizontalAlignment="Stretch">

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                        <TextBlock Text="{DynamicResource MTDA_Provider}" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <ComboBox ItemsSource="{Binding Settings.ProviderPresetOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.ProviderPreset}"
                                      SelectionChanged="ProviderPreset_OnSelectionChanged"
                                      MinWidth="260"
                                      Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource MTDA_ApplyProvider}" MinWidth="140" Click="ApplyProvider_OnClick"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource GlyphBrush}"
                                Background="{DynamicResource PopupBackgroundBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10"
                                Margin="0,0,0,10"
                                Opacity="0.9">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.ProviderKeyHelp, Mode=OneWay}" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Settings.ProviderBillingHelp, Mode=OneWay}" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0">
                                    <Run Text="{DynamicResource MTDA_KeyHelpPage}" FontWeight="SemiBold"/>
                                    <Hyperlink Click="OpenProviderPage_OnClick">
                                        <Run Text="{Binding Settings.ProviderKeyUrl, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                                <Button Content="{DynamicResource MTDA_OpenProviderPage}" HorizontalAlignment="Left" MinWidth="170" Margin="0,8,0,0" Click="OpenProviderPage_OnClick"/>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                        <StackPanel Visibility="{Binding Settings.ShowEndpointEditor, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,10">
